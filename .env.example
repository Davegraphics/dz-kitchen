# Copy this file to .env and replace the placeholder values.
# Never commit your real .env file or share its secrets.

# Neon pooled PostgreSQL connection string (SSL required).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Use a long random secret with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

PORT=3001
NODE_ENV=development

# Cloudinary Console -> Product environment -> API keys.
# Keep these server-side: do not prefix them with VITE_.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
